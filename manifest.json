{
  "manifest_version": 3,
  "name": "ATLAS ChatGPT Workflow Controls",
  "version": "0.1.0",
  "description": "First-party ATLAS workflow controls for chatgpt.com.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
