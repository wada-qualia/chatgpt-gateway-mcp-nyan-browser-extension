{
  "name": "chatgpt-gateway-mcp-nyan-browser-extension",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:unpacked": "node scripts/build-unpacked.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests && node --check scripts/build.mjs && node --check scripts/build-unpacked.mjs && node --check scripts/validate-manifest.mjs && node --check scripts/generate-sbom.mjs && node --check scripts/generate-provenance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest:check": "node scripts/validate-manifest.mjs",
    "package": "bash scripts/package.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run manifest:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "ajv": "8.20.0",
    "typescript-eslint": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  }
}
